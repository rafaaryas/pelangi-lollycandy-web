# Copy these values into Vercel Project Settings > Environment Variables.
# Do not commit a populated .env file or put secrets in vercel.json.

APP_NAME="Pelangi Lollycandy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate_--show

# Use a managed MySQL-compatible database reachable from Vercel.
DB_CONNECTION=mysql
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require

# Stateless serverless-safe defaults. Override only with external shared services.
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
VIEW_COMPILED_PATH=/tmp
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php

# Set when AI autofill is used.
AI_AUTOFILL_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
